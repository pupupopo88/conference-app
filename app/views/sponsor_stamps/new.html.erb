<% content_for(:page_title, @sponsor[:name]) %>

<div class="w-full max-w-xl mx-auto px-4 py-8 text-center">
  <section class="overflow-hidden rounded-2xl bg-white shadow-sm">
    <div class="bg-gray-100 px-6 py-10" data-sponsor-logo-stage>
      <%= image_tag @sponsor_logo_url,
            alt: "",
            class: "mx-auto h-36 w-36 border border-gray-300 bg-white object-contain shadow-sm",
            data: {sponsor_logo: true} %>
    </div>

    <div class="px-6 py-7 sm:px-8">
      <h1 class="text-2xl font-black text-gray-900"><%= @sponsor[:name] %></h1>
      <p class="mt-1 text-gray-600"><%= t(".plan", plan: @sponsor[:plan].capitalize) %></p>
      <%= render "shared/sponsor_labels", sponsor: @sponsor %>

      <%= button_to sponsor_passport_stamps_path(@event.slug),
            params: {code: params[:code]},
            class: "inline-flex w-full items-center justify-center rounded-lg bg-theme-primary-700 px-5 py-3 font-bold text-white shadow-sm disabled:cursor-wait disabled:opacity-70",
            form: {class: "mt-7 w-full"},
            data: {turbo_submits_with: t(".collecting_stamp")},
            aria: {live: "polite"} do %>
        <%= t(".collect_stamp") %>
      <% end %>
    </div>
  </section>
</div>
