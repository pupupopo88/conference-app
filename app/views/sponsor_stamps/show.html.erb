<% content_for(:page_title, t(".title")) %>

<div class="passport-page w-full max-w-xl mx-auto px-4 py-6 text-center">
  <section class="passport-cover passport-sheet" aria-labelledby="stamp-result-title">
    <div class="mb-6 flex items-center justify-between gap-3">
      <p class="passport-eyebrow">SPONSOR PASSPORT</p>
      <span class="passport-year"><%= @event.slug %></span>
    </div>

    <h1 id="stamp-result-title" class="<%= class_names("text-xl font-bold sm:text-2xl", "passport-result-title--new" => @newly_visited) %>">
      <% if @progress.completed? %>
        <%= t(".complete_title") %>
      <% elsif @newly_visited %>
        <%= t(".title") %>
      <% else %>
        <%= t(".already_visited") %>
      <% end %>
    </h1>
    <% if @progress.completed? %>
      <p class="mt-2 text-balance text-sm leading-relaxed passport-muted"><%= t(".complete_message") %></p>
    <% end %>

    <div class="mt-6">
      <%= tag.div(
            class: class_names("passport-stamp-stage", {"passport-stamp-stage--new" => @newly_visited}),
            data: {new_stamp_celebration: @newly_visited || nil}
          ) do %>
        <% if @newly_visited %>
          <div class="passport-stamp-burst" aria-hidden="true"></div>
          <div class="passport-confetti" aria-hidden="true">
            <% 12.times do %>
              <span></span>
            <% end %>
          </div>
          <span class="passport-stamp-new-label" aria-hidden="true">NEW!</span>
        <% end %>

        <div class="passport-stamp" aria-label="<%= t(".stamp_number", number: @visit_number) %>">
          <span class="text-sm font-black tracking-widest" aria-hidden="true">VISITED</span>
          <span class="text-5xl font-black leading-none" aria-hidden="true">#<%= @visit_number.to_s.rjust(2, "0") %></span>
          <span class="text-xs font-bold" aria-hidden="true">KoR <%= @event.slug %></span>
        </div>
      <% end %>
    </div>

    <div>
      <p class="passport-sponsor-plan"><%= t(".plan", plan: @sponsor[:plan].capitalize) %></p>
      <p class="mt-2 break-words text-2xl font-bold"><%= @sponsor[:name] %></p>
      <%= render "shared/sponsor_labels", sponsor: @sponsor %>
    </div>

    <section class="passport-next-goal text-left" aria-label="<%= t("sponsor_passports.show.progress") %>">
      <%= render "sponsor_passports/progress", passport: @passport, updated: @newly_visited %>
      <% if @progress.next_milestone %>
        <p class="mt-4 text-sm font-bold"><%= t("sponsor_passports.show.next_milestone", count: @progress.remaining_to_next) %></p>
      <% end %>
      <% if @progress.current_milestone %>
        <p class="mt-2 text-sm font-bold passport-achievement"><%= t("sponsor_passports.show.milestones.#{@progress.current_milestone[:key]}") %></p>
      <% end %>
    </section>

    <% if @passport.next_sponsors.any? %>
      <section class="passport-next-goal text-left" aria-labelledby="next-sponsors-title">
        <h2 id="next-sponsors-title" class="text-base font-bold"><%= t(".next_sponsors_title") %></h2>
        <ul class="mt-3 grid gap-3">
          <% @passport.next_sponsors.each do |sponsor| %>
            <li class="passport-entry" data-next-sponsor="<%= sponsor[:key] %>">
              <p class="passport-sponsor-plan"><%= t(".plan", plan: sponsor[:plan].capitalize) %></p>
              <p class="mt-1 font-bold"><%= sponsor[:name] %></p>
              <%= render "shared/sponsor_labels", sponsor: sponsor, plain: true %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <div class="passport-collection-action">
      <%= link_to t(".view_stamp_card"), sponsor_passport_path(event_slug: @event.slug), class: "passport-collect-button inline-flex w-full items-center justify-center rounded-lg px-5 py-4 font-bold text-white" %>
      <%= link_to t(".back_to_profile"), profiles_path, class: "mt-4 inline-block py-2 text-sm underline underline-offset-4 passport-muted" %>
    </div>
  </section>
</div>
