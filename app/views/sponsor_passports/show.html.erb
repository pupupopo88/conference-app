<% content_for(:page_title, t(".title")) %>
<% progress = @passport.progress %>

<div class="passport-page w-full max-w-3xl mx-auto px-4 py-6">
  <header class="passport-cover">
    <div class="mb-4 flex items-center justify-between gap-3">
      <p class="passport-eyebrow">KAIGI ON RAILS</p>
      <span class="passport-year"><%= @passport.event.slug %></span>
    </div>
    <h1 class="text-xl font-bold sm:text-2xl"><%= t(".title") %></h1>
    <p class="mt-2 text-sm passport-muted"><%= t(".book_description") %></p>

    <section class="mt-6" aria-label="<%= t(".progress") %>">
      <%= render "sponsor_passports/progress", passport: @passport %>

      <% if progress.total_count.positive? && progress.completed? %>
        <div class="passport-complete" data-passport-complete>
          <span class="passport-complete-seal" aria-hidden="true">✓</span>
          <div>
            <p class="font-bold"><%= t(".milestones.complete") %></p>
            <p class="mt-1 text-sm"><%= t(".book_complete") %></p>
          </div>
        </div>
      <% else %>
        <div class="passport-next-goal">
          <% if progress.next_milestone %>
            <p class="text-sm font-bold"><%= t(".next_milestone", count: progress.remaining_to_next) %></p>
          <% end %>
          <p class="mt-1 text-xs passport-muted">
            <%= progress.current_milestone ? t(".milestones.#{progress.current_milestone[:key]}") : t(".no_badge") %>
          </p>
        </div>
      <% end %>
    </section>
    <% if progress.visited_count.zero? %>
      <p class="mt-4 text-sm leading-relaxed passport-muted"><%= t(".empty") %></p>
    <% end %>
  </header>

  <%= render "stamp_grid", passport: @passport %>
</div>
