<% content_for(:page_title, t(".title")) %>
<% progress = @passport.progress %>

<div class="w-full max-w-3xl mx-auto px-4 py-6">
  <header class="mb-6">
    <h1 class="mb-3 text-xl font-bold"><%= t(".title") %></h1>

    <section class="rounded-xl bg-white p-4 text-gray-900 shadow-sm" aria-labelledby="sponsor-visit-progress-title">
      <div class="flex items-start justify-between gap-4">
        <div class="text-left">
          <p id="sponsor-visit-progress-title" class="text-xs font-bold text-gray-500"><%= t(".progress") %></p>
          <p class="mt-1 text-2xl font-black" aria-label="<%= t(".progress_count", visited: progress.visited_count, total: progress.total_count) %>">
            <%= progress.visited_count %> / <%= progress.total_count %>
          </p>
        </div>
        <div class="shrink-0 rounded-lg bg-gray-100 px-3 py-2 text-right">
          <p class="text-xs font-bold text-gray-500"><%= t("sponsor_passports.community_stamp_count.label") %></p>
          <p class="text-xl font-black" data-community-stamp-count>
            <%= t("sponsor_passports.community_stamp_count.count", count: @passport.community_stamp_count, formatted_count: number_with_delimiter(@passport.community_stamp_count)) %>
          </p>
        </div>
      </div>

      <%= render "sponsor_passports/progress_bar", progress: progress, height_class: "h-3" %>

      <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-gray-200 pt-3 text-left">
        <p class="rounded-full px-3 py-1 text-xs font-black <%= progress.current_milestone ? "bg-theme-primary-700 text-white" : "bg-gray-200 text-gray-600" %>">
          <% if progress.current_milestone %>
            <%= t(".milestones.#{progress.current_milestone[:key]}") %>
          <% else %>
            <%= t(".no_badge") %>
          <% end %>
        </p>
        <% if progress.next_milestone %>
          <p class="text-xs font-semibold text-gray-600">
            <%= t(".next_milestone", count: progress.remaining_to_next) %>
          </p>
        <% end %>
      </div>
    </section>
  </header>

  <% if progress.visited_count.zero? %>
    <p class="mb-6 text-center text-theme-primary"><%= t(".empty") %></p>
  <% end %>

  <%= render "stamp_grid", passport: @passport %>
</div>
